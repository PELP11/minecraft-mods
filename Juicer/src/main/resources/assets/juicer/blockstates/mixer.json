{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "juicer:block/mixer"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "juicer:block/mixer",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "juicer:block/mixer",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "juicer:block/mixer",
        "y": 270
      }
    },
    {
      "when": {
        "active": "false"
      },
      "apply": {
        "model": "juicer:block/mixer_blades"
      }
    },
    {
      "when": {
        "active": "true"
      },
      "apply": {
        "model": "juicer:block/mixer_blades_spinning"
      }
    },
    {
      "when": {
        "contents": "starfruit",
        "level": "1"
      },
      "apply": {
        "model": "juicer:block/mixer_liquid_starfruit_1"
      }
    },
    {
      "when": {
        "contents": "starfruit",
        "level": "2"
      },
      "apply": {
        "model": "juicer:block/mixer_liquid_starfruit_2"
      }
    },
    {
      "when": {
        "contents": "starfruit",
        "level": "3"
      },
      "apply": {
        "model": "juicer:block/mixer_liquid_starfruit_3"
      }
    },
    {
      "when": {
        "contents": "starfruit",
        "level": "4"
      },
      "apply": {
        "model": "juicer:block/mixer_liquid_starfruit_4"
      }
    },
    {
      "when": {
        "contents": "dragonfruit",
        "level": "1"
      },
      "apply": {
        "model": "juicer:block/mixer_liquid_dragonfruit_1"
